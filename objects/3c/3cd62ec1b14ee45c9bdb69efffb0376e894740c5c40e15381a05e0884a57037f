<?php

declare(strict_types=1);

namespace Binos\Estimate;

final readonly class EstimateHandler
{
    private const string HONEYPOT = 'company';

    private EstimateEmails $emails;
    private SpamGuard $guard;

    public function __construct(private Mailer $mailer, RateLimiter $limiter, string $ownerAddress)
    {
        $this->emails = new EstimateEmails($ownerAddress);
        $this->guard = new SpamGuard($limiter);
    }

    /** @param array<mixed> $post */
    public function handle(array $post, string $clientId): HandlerResult
    {
        if (self::isBot($post)) {
            return HandlerResult::sent();
        }
        try {
            $request = EstimateRequest::fromPost($post);
            $blocked = $this->guard->check($request, $clientId);
            if ($blocked !== null) {
                return $blocked;
            }
            $this->mailer->send($this->emails->forOwner($request));
        } catch (InvalidRequest $error) {
            return HandlerResult::failed(422, $error->getMessage());
        } catch (MailFailed) {
            return HandlerResult::failed(502, "We couldn't send your request.");
        }
        $this->confirmToCustomer($request);
        return HandlerResult::sent();
    }

    private function confirmToCustomer(EstimateRequest $request): void
    {
        $confirmation = $this->emails->forCustomer($request);
        if ($confirmation === null) {
            return;
        }
        try {
            $this->mailer->send($confirmation);
        } catch (MailFailed) {
            return;
        }
    }

    /** @param array<mixed> $post */
    private static function isBot(array $post): bool
    {
        $trap = $post[self::HONEYPOT] ?? '';
        return !is_string($trap) || trim($trap) !== '';
    }
}
